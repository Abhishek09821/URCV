# ============================================================================
# URCV Backend - MVP Configuration Template
# ============================================================================
# Copy this file to .env and update with your actual values
# ============================================================================

# ----------------------------------------------------------------------------
# APPLICATION
# ----------------------------------------------------------------------------
APP_NAME=URCV
ENVIRONMENT=development
DEBUG=true

# ----------------------------------------------------------------------------
# SECURITY (⚠️ REQUIRED - Generate a secure key!)
# ----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-secure-random-string-minimum-32-characters

# ----------------------------------------------------------------------------
# DATABASE (PostgreSQL) - REQUIRED
# ----------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_USER=urcv_user
POSTGRES_PASSWORD=urcv_password
POSTGRES_DB=urcv_db
POSTGRES_PORT=5432

# ----------------------------------------------------------------------------
# REDIS (Caching) - REQUIRED
# ----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=  # Uncomment if Redis requires authentication

# ----------------------------------------------------------------------------
# S3 STORAGE (File uploads) - REQUIRED
# ----------------------------------------------------------------------------
# For local development with MinIO:
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=urcv-files
S3_REGION=us-east-1
S3_USE_SSL=false

# For production with AWS S3:
# Remove or comment out S3_ENDPOINT_URL
# Set your AWS credentials:
# S3_ACCESS_KEY_ID=your-aws-access-key
# S3_SECRET_ACCESS_KEY=your-aws-secret-key
# S3_BUCKET_NAME=your-bucket-name
# S3_REGION=us-east-1
# S3_USE_SSL=true

# ----------------------------------------------------------------------------
# AI SERVICES - OPTIONAL (Required for AI improvement features)
# ----------------------------------------------------------------------------
# Get your API key from: https://console.anthropic.com/
# Uncomment to enable AI improvements:
# ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ----------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# ----------------------------------------------------------------------------
# Frontend URLs allowed to access the API
# 
# Format 1: Comma-separated string
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
#
# Format 2: JSON array (alternative)
# BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
#
# For production, add your actual frontend domain:
# BACKEND_CORS_ORIGINS=https://yourdomain.com,http://localhost:3000

# ----------------------------------------------------------------------------
# MONITORING - OPTIONAL (Recommended for production)
# ----------------------------------------------------------------------------
# Sentry error tracking: https://sentry.io/
# Uncomment to enable error tracking:
# SENTRY_DSN=https://your-sentry-dsn-here

# ----------------------------------------------------------------------------
# LOGGING
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json  # Options: json, text

# ============================================================================
# Advanced Configuration (Use defaults unless you need to customize)
# ============================================================================

# File Upload Limits
# MAX_UPLOAD_SIZE=10485760  # 10MB in bytes

# PDF Processing
# PDF_DPI=300
# PDF_MAX_PAGES=5
# OCR_LANGUAGE=eng

# AI Configuration (when ANTHROPIC_API_KEY is set)
# AI_MODEL_CLAUDE=claude-3-5-sonnet-20241022
# AI_MAX_TOKENS=1000
# AI_TEMPERATURE=0.7

# Security Tokens
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7
# PASSWORD_MIN_LENGTH=8

# Rate Limiting
# RATE_LIMIT_PER_MINUTE=60
# RATE_LIMIT_PER_HOUR=1000

# Caching
# CACHE_TTL_SECONDS=3600  # 1 hour
# ATS_CACHE_TTL_SECONDS=86400  # 24 hours

# Resume Parser
# PARSER_TIMEOUT_SECONDS=60
# CONFIDENCE_THRESHOLD_VERIFICATION=85
# CONFIDENCE_THRESHOLD_LOW=60

# Template Engine
# TEMPLATE_RENDER_TIMEOUT_SECONDS=30
# TEMPLATE_MAX_WORD_COUNT=250
