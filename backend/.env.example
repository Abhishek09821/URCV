# Application
APP_NAME=URCV
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# API
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Security
SECRET_KEY=your-secret-key-here-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8

# Database
POSTGRES_SERVER=localhost
POSTGRES_USER=urcv_user
POSTGRES_PASSWORD=urcv_password
POSTGRES_DB=urcv_db
POSTGRES_PORT=5432
# DATABASE_URL=postgresql+asyncpg://urcv_user:urcv_password@localhost:5432/urcv_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# REDIS_URL=redis://localhost:6379/0

# S3 Storage (MinIO for local development)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET_NAME=urcv-files
S3_USE_SSL=false

# For production (AWS S3), remove S3_ENDPOINT_URL and set:
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=your-aws-access-key
# S3_SECRET_ACCESS_KEY=your-aws-secret-key
# S3_USE_SSL=true

# File Upload
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
UPLOAD_FOLDER=uploads

# PDF Processing
PDF_DPI=300
OCR_LANGUAGE=eng
PDF_MAX_PAGES=5

# AI Services
ANTHROPIC_API_KEY=sk-ant-api...
GEMINI_API_KEY=
AI_MODEL_CLAUDE=claude-3-5-sonnet-20241022
AI_MODEL_GEMINI=gemini-pro
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.7

# Celery
# CELERY_BROKER_URL will use REDIS_URL by default
# CELERY_RESULT_BACKEND will use REDIS_URL by default

# Email (optional)
SMTP_TLS=true
SMTP_PORT=587
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=URCV

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Monitoring (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Feature Flags
ENABLE_AI_IMPROVEMENTS=true
ENABLE_JD_MATCHING=true
ENABLE_TEMPLATE_CONVERSION=true
ENABLE_ATS_ANALYSIS=true

# Cache
CACHE_TTL_SECONDS=3600
ATS_CACHE_TTL_SECONDS=86400

# Confidence Thresholds
CONFIDENCE_THRESHOLD_VERIFICATION=85
CONFIDENCE_THRESHOLD_LOW=60

# Parser
PARSER_VERSION=1.0.0
PARSER_TIMEOUT_SECONDS=60

# Template
TEMPLATE_RENDER_TIMEOUT_SECONDS=30
TEMPLATE_MAX_WORD_COUNT=250
